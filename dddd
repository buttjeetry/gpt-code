:root {
  color-scheme: dark;
  --bg: #0b0f1f;
  --panel: rgba(20, 28, 55, 0.65);
  --panel-strong: rgba(27, 38, 75, 0.95);
  --text: #f2f4ff;
  --muted: #9aa3c7;
  --accent: #7cf9ff;
  --accent-strong: #5b7cfa;
  --pill: #1b2a52;
  --shadow: 0 18px 45px rgba(5, 9, 30, 0.5);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family: "Space Grotesk", system-ui, -apple-system, sans-serif;
}

body {
  background: radial-gradient(circle at top, #1c2b59 0%, #0b0f1f 45%, #070914 100%);
  color: var(--text);
  min-height: 100vh;
}

.app {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.app-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24px clamp(20px, 6vw, 80px);
  position: sticky;
  top: 0;
  backdrop-filter: blur(20px);
  background: rgba(7, 9, 20, 0.75);
  border-bottom: 1px solid rgba(124, 249, 255, 0.15);
  z-index: 10;
}

.logo {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-mark {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  background: linear-gradient(135deg, #5b7cfa, #7cf9ff);
  box-shadow: 0 0 20px rgba(124, 249, 255, 0.4);
}

.logo-title {
  font-weight: 600;
  font-size: 1.05rem;
}

.logo-subtitle {
  color: var(--muted);
  font-size: 0.85rem;
}

.primary-btn,
.ghost-btn {
  padding: 12px 18px;
  border-radius: 999px;
  border: none;
  cursor: pointer;
  font-weight: 600;
  letter-spacing: 0.3px;
}

.primary-btn {
  background: linear-gradient(120deg, #5b7cfa, #7cf9ff);
  color: #0b0f1f;
  box-shadow: 0 10px 25px rgba(91, 124, 250, 0.35);
}

.ghost-btn {
  background: transparent;
  color: var(--text);
  border: 1px solid rgba(124, 249, 255, 0.35);
}

.app-main {
  padding: 40px clamp(20px, 6vw, 80px) 60px;
  display: flex;
  flex-direction: column;
  gap: 60px;
}

.hero {
  display: grid;
  gap: 32px;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  align-items: center;
}

.hero-copy h1 {
  font-size: clamp(2rem, 4vw, 3.2rem);
  margin: 18px 0;
}

.hero-copy p {
  color: var(--muted);
  line-height: 1.6;
}

.hero-actions {
  margin: 24px 0;
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

.pill {
  display: inline-flex;
  padding: 6px 14px;
  background: var(--pill);
  border-radius: 999px;
  font-size: 0.85rem;
  color: var(--accent);
}

.hero-metrics {
  display: flex;
  gap: 28px;
  flex-wrap: wrap;
  margin-top: 12px;
}

.hero-metrics h3 {
  font-size: 1.5rem;
}

.hero-metrics p {
  color: var(--muted);
  font-size: 0.85rem;
}

.hero-visual {
  display: flex;
  justify-content: center;
}

.glass-card {
  background: var(--panel);
  border-radius: 24px;
  padding: 24px;
  width: min(360px, 100%);
  box-shadow: var(--shadow);
  border: 1px solid rgba(124, 249, 255, 0.2);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status {
  font-size: 0.75rem;
  color: var(--accent);
}

.trace {
  margin: 20px 0;
  display: grid;
  gap: 14px;
}

.trace p {
  font-weight: 600;
}

.trace small {
  color: var(--muted);
}

.code-preview {
  background: rgba(5, 9, 25, 0.8);
  border-radius: 16px;
  padding: 14px;
  font-size: 0.85rem;
  color: var(--accent);
}

.skills h2,
.workspace h2 {
  font-size: clamp(1.6rem, 2.5vw, 2rem);
  margin-bottom: 24px;
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}

.skill-card {
  background: var(--panel-strong);
  padding: 20px;
  border-radius: 20px;
  border: 1px solid rgba(124, 249, 255, 0.12);
  box-shadow: var(--shadow);
}

.skill-card h3 {
  margin-bottom: 12px;
}

.skill-card p {
  color: var(--muted);
  margin-bottom: 18px;
  line-height: 1.5;
}

.skill-card span {
  color: var(--accent);
  font-size: 0.85rem;
}

.workspace-header {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 16px;
  align-items: center;
  margin-bottom: 20px;
}

.workspace-body {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
}

.editor {
  background: var(--panel-strong);
  border-radius: 20px;
  border: 1px solid rgba(124, 249, 255, 0.15);
  padding: 18px;
  min-height: 320px;
}

.editor-tabs {
  display: flex;
  gap: 10px;
  margin-bottom: 18px;
}

.tab {
  background: rgba(7, 9, 20, 0.8);
  color: var(--text);
  border: none;
  padding: 8px 14px;
  border-radius: 999px;
  font-size: 0.8rem;
  cursor: pointer;
}

.tab.active {
  background: linear-gradient(120deg, #5b7cfa, #7cf9ff);
  color: #0b0f1f;
}

.editor-content {
  color: var(--accent);
  font-size: 0.85rem;
  line-height: 1.6;
  white-space: pre-wrap;
}

.workspace-side {
  display: grid;
  gap: 16px;
}

.panel {
  background: var(--panel);
  padding: 18px;
  border-radius: 20px;
  border: 1px solid rgba(124, 249, 255, 0.12);
  display: grid;
  gap: 12px;
}

.panel ul {
  list-style: none;
  display: grid;
  gap: 8px;
  color: var(--muted);
  font-size: 0.9rem;
}

.avatars {
  display: flex;
  gap: 10px;
}

.avatars span {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: linear-gradient(135deg, #5b7cfa, #7cf9ff);
  box-shadow: 0 0 12px rgba(124, 249, 255, 0.4);
}

.app-footer {
  margin-top: auto;
  padding: 20px clamp(20px, 6vw, 80px) 30px;
}

.bottom-nav {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
  background: rgba(7, 9, 20, 0.85);
  padding: 14px;
  border-radius: 18px;
  border: 1px solid rgba(124, 249, 255, 0.1);
}

.bottom-nav a {
  text-decoration: none;
  color: var(--muted);
  font-size: 0.85rem;
  text-align: center;
  padding: 8px 0;
  border-radius: 12px;
}

.bottom-nav a.active {
  color: #0b0f1f;
  background: linear-gradient(120deg, #5b7cfa, #7cf9ff);
  font-weight: 600;
}

@media (max-width: 720px) {
  .app-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .hero-metrics {
    gap: 16px;
  }

  .bottom-nav {
    grid-template-columns: repeat(2, 1fr);
  }
}
